  <!-- Interactive JavaScript for Category Filtering & Modal Dialog -->
  <script is:inline>
    // Filtering Logic
    const filterButtons = document.querySelectorAll('.tab-btn');
    const burgerCards = document.querySelectorAll('.burger-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');
        burgerCards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Modal Details Logic
    const modal = document.getElementById('burgerModal');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const modalCloseAction = document.getElementById('modalCloseAction');
    const detailButtons = document.querySelectorAll('.open-details-btn');

    function openModalWithData(burger) {
      document.getElementById('modalImg').src = burger.image;
      document.getElementById('modalImg').alt = burger.name;
      document.getElementById('modalBurgerTitle').textContent = burger.name;
      document.getElementById('modalSpecialty').textContent = burger.specialtyLevel;
      document.getElementById('modalDesc').textContent = burger.description;
      document.getElementById('modalPrice').textContent = `$${burger.price.toFixed(2)}`;
      document.getElementById('modalRating').textContent = `⭐ ${burger.rating} (${burger.reviews} reseñas)`;
      document.getElementById('modalPrep').textContent = burger.prepTime;
      document.getElementById('modalCalories').textContent = burger.calories;
      document.getElementById('modalPairing').textContent = burger.pairing || 'Papas rústicas y bebida fría';
      document.getElementById('modalChefNotes').textContent = burger.chefNotes ? `Nota del Chef: "${burger.chefNotes}"` : '';

      const badgeElem = document.getElementById('modalBadge');
      badgeElem.textContent = burger.badge;
      if (burger.badgeStyle) {
        badgeElem.setAttribute('style', `position: static; box-shadow: none; ${burger.badgeStyle}`);
      }

      const ingrList = document.getElementById('modalIngredients');
      ingrList.innerHTML = '';
      if (burger.ingredients && burger.ingredients.length) {
        burger.ingredients.forEach(item => {
          const li = document.createElement('li');
          li.innerHTML = `<span>✓</span> ${item}`;
          ingrList.appendChild(li);
        });
      }

      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.remove('open');
      document.body.style.overflow = 'auto';
    }

    detailButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        try {
          const data = JSON.parse(btn.getAttribute('data-burger'));
          openModalWithData(data);
        } catch (e) {
          console.error('Error parsing burger data:', e);
        }
      });
    });

    closeModalBtn.addEventListener('click', closeModal);
    modalCloseAction.addEventListener('click', closeModal);

    // Close on backdrop click
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('open')) {
        closeModal();
      }
    });
  </script>

</body>
</html>
