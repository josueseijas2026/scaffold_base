    .passion-title {
      font-family: var(--font-display);
      font-size: 4rem;
      line-height: 0.92;
      color: #0C0C0E;
      letter-spacing: 0.02em;
      margin-bottom: 1.25rem;
    }
    .passion-text {
      font-size: 0.98rem;
      color: #1F2937;
      line-height: 1.6;
      font-weight: 600;
      margin-bottom: 2rem;
    }
    .btn-our-story {
      background: #0C0C0E;
      color: #FFFFFF;
      font-size: 0.88rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 0.85rem 1.85rem;
      border-radius: var(--radius-pill);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      transition: all 0.2s ease;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
    }
    .btn-our-story:hover {
      background: #27272A;
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
    }

    /* Real Ingredients Stamp Stamp Badge */
    .real-stamp-wrap {
      flex-shrink: 0;
      margin-left: 2rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .real-stamp-circle {
      width: 140px;
      height: 140px;
      border-radius: 50%;
      border: 3px solid #0C0C0E;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 0.75rem;
      position: relative;
    }
    .real-stamp-circle::after {
      content: '';
      position: absolute;
      inset: 4px;
      border: 1px dashed #0C0C0E;
      border-radius: 50%;
    }
    .stamp-arc-text {
      font-family: var(--font-display);
      font-size: 0.95rem;
      letter-spacing: 0.08em;
      color: #0C0C0E;
      line-height: 1;
    }
    .stamp-icon {
      margin: 4px 0;
      color: #0C0C0E;
    }
    .stamp-script {
      font-family: var(--font-script);
      font-size: 1.45rem;
      line-height: 1;
      color: #0C0C0E;
      font-weight: 700;
    }

    /* PWA Mobile & Admin Ecosystem Bridge */
    .ecosystem-section {
      background: #111114;
      border-top: 1px solid var(--border-dark);
      border-bottom: 1px solid var(--border-dark);
      padding: 4rem 2rem;
    }
    .ecosystem-container {
      max-width: 1280px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 3rem;
      align-items: center;
    }
    .eco-text h2 {
      font-family: var(--font-display);
      font-size: 2.8rem;
      letter-spacing: 0.02em;
      color: #FFFFFF;
      margin-bottom: 0.75rem;
      line-height: 1.05;
    }
    .eco-text p {
      font-size: 1rem;
      color: #9CA3AF;
      line-height: 1.6;
      margin-bottom: 1.75rem;
    }
    .eco-features-list {
      display: flex;
      gap: 1.25rem;
      flex-wrap: wrap;
      margin-bottom: 2rem;
    }
    .eco-feature-pill {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 0.4rem 0.85rem;
      border-radius: var(--radius-pill);
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--brand-gold);
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .eco-actions {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .eco-card-preview {
      background: #18181D;
      border: 1px solid rgba(255, 168, 0, 0.25);
      border-radius: var(--radius-lg);
      padding: 2.25rem 2rem;
      text-align: center;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
    }

    /* Testimonials Section */
    .testimonials-section {
      background: var(--bg-dark);
      padding: 4.5rem 2rem;
      border-bottom: 1px solid var(--border-dark);
    }
    .testimonials-container {
      max-width: 1280px;
      margin: 0 auto;
    }
    .testi-header {
      text-align: center;
      margin-bottom: 3rem;
    }
    .testi-header .script-sub {
      font-family: var(--font-script);
      font-size: 2rem;
      color: var(--brand-gold);
      display: block;
    }
    .testi-header h2 {
      font-family: var(--font-display);
      font-size: 3.5rem;
      letter-spacing: 0.02em;
      color: var(--text-white);
    }
    .testimonials-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
    }
    .testi-card {
      background: var(--bg-dark-secondary);
      border: 1px solid var(--border-dark);
      border-radius: var(--radius-md);
      padding: 1.85rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .testi-stars {
      color: var(--brand-gold);
      font-size: 1.05rem;
      margin-bottom: 1rem;
    }
    .testi-comment {
      font-size: 0.95rem;
      color: #D1D5DB;
      font-style: italic;
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }
    .testi-author {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }
    .testi-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--brand-gold);
    }
    .testi-name {
      font-weight: 800;
      color: var(--text-white);
      font-size: 0.92rem;
    }
    .testi-role {
      font-size: 0.78rem;
      color: #9CA3AF;
    }

    /* Footer (Matching Reference Image) */
    footer.site-footer {
      background: #0A0A0C;
      color: #FFFFFF;
      padding: 4.5rem 2rem 2rem;
      border-top: 1px solid var(--border-dark);
    }
    .footer-container {
      max-width: 1280px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.2fr 1fr 1fr 1.3fr;
      gap: 3rem;
      margin-bottom: 3.5rem;
    }
    .footer-col-brand .brand-logo {
      margin-bottom: 1.25rem;
    }
    .footer-brand-desc {
      font-size: 0.88rem;
      color: #9CA3AF;
      line-height: 1.6;
      max-width: 290px;
    }
    .footer-col h4 {
      font-family: var(--font-display);
      font-size: 1.25rem;
      letter-spacing: 0.05em;
      color: var(--text-white);
      margin-bottom: 1.25rem;
      text-transform: uppercase;
    }
    .footer-col ul {
      list-style: none;
    }
    .footer-col li {
      margin-bottom: 0.65rem;
    }
    .footer-col a {
      text-decoration: none;
      color: #9CA3AF;
      font-size: 0.88rem;
      transition: color 0.2s ease;
    }
    .footer-col a:hover {
      color: var(--brand-gold);
    }
    .footer-hours-row {
      display: flex;
      justify-content: space-between;
      font-size: 0.85rem;
      color: #9CA3AF;
      margin-bottom: 0.5rem;
    }
    .footer-hours-row span:first-child {
      color: #D1D5DB;
      font-weight: 600;
    }

    /* Social Icons & Order Ahead Card */
    .social-icons-row {
      display: flex;
      gap: 0.75rem;
      margin-bottom: 1.25rem;
    }
    .social-btn {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      transition: all 0.2s ease;
    }
    .social-btn:hover {
      background: var(--brand-gold);
      color: #0C0C0E;
      border-color: var(--brand-gold);
      transform: translateY(-2px);
    }
    .social-btn svg {
      width: 16px;
      height: 16px;
    }

    /* Order Ahead Card in Footer */
    .order-ahead-card {
      background: #141418;
      border: 1px solid var(--border-dark-gold);
      border-radius: var(--radius-sm);
      padding: 0.85rem 1rem;
      display: flex;
      align-items: center;
      gap: 0.85rem;
      text-decoration: none;
      color: #FFFFFF;
      transition: all 0.2s ease;
    }
    .order-ahead-card:hover {
      border-color: var(--brand-gold);
      background: #1A1A20;
      transform: translateY(-2px);
    }
    .order-ahead-icon {
      color: var(--brand-gold);
      font-size: 1.5rem;
    }
    .order-ahead-text {
      flex: 1;
    }
    .order-ahead-text small {
      font-size: 0.68rem;
      color: #9CA3AF;
      text-transform: uppercase;
      font-weight: 700;
      letter-spacing: 0.05em;
      display: block;
    }
    .order-ahead-text strong {
      font-family: var(--font-display);
      font-size: 1.15rem;
      letter-spacing: 0.05em;
      color: var(--brand-gold);
      display: block;
      line-height: 1.1;
    }

    /* Footer Bottom Bar */
    .footer-bottom-bar {
      max-width: 1280px;
      margin: 0 auto;
      border-top: 1px solid var(--border-dark);
      padding-top: 1.75rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.82rem;
      color: #6B7280;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .footer-bottom-bar a {
      color: var(--brand-gold);
      text-decoration: none;
      font-weight: 600;
    }

    /* Interactive Details Modal Dialog */
    .modal-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(10, 10, 12, 0.85);
      backdrop-filter: blur(10px);
      z-index: 100;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }
    .modal-overlay.open {
      display: flex;
      animation: modalFade 0.25s ease-out forwards;
    }
    @keyframes modalFade {
      from { opacity: 0; transform: scale(0.96); }
      to { opacity: 1; transform: scale(1); }
    }
    .modal-sheet {
      background: #16161A;
      color: #FFFFFF;
      border-radius: var(--radius-lg);
      max-width: 650px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      border: 1px solid rgba(255, 168, 0, 0.3);
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8);
      position: relative;
    }
    .modal-sheet-close {
      position: absolute;
      top: 1rem;
      right: 1rem;
      width: 36px;
      height: 36px;
      background: rgba(0, 0, 0, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 50%;
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      cursor: pointer;
      z-index: 10;
      transition: all 0.2s;
    }
    .modal-sheet-close:hover {
      background: var(--brand-gold);
      color: #0C0C0E;
    }
    .modal-hero-photo {
      width: 100%;
      height: 260px;
      object-fit: cover;
    }
    .modal-inner-padding {
      padding: 1.75rem 2rem 2rem;
    }
    .modal-header-line {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.5rem;
    }
    .modal-pill-badge {
      background: var(--brand-gold);
      color: #0C0C0E;
      font-size: 0.75rem;
      font-weight: 800;
      padding: 0.25rem 0.75rem;
      border-radius: var(--radius-pill);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .modal-burger-heading {
      font-family: var(--font-display);
      font-size: 2.2rem;
      color: #FFFFFF;
      letter-spacing: 0.03em;
      margin-bottom: 0.35rem;
    }
    .modal-specialty-sub {
      color: var(--brand-gold);
      font-weight: 700;
      font-size: 0.9rem;
      margin-bottom: 0.85rem;
    }
    .modal-burger-desc {
      font-size: 0.95rem;
      color: #D1D5DB;
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }
    .modal-ingredients-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
      list-style: none;
    }
    .modal-ingredients-grid li {
      font-size: 0.82rem;
      background: #202026;
      padding: 0.5rem 0.75rem;
      border-radius: var(--radius-sm);
      color: #E5E7EB;
      display: flex;
      align-items: center;
      gap: 0.45rem;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }
    .modal-ingredients-grid li span {
      color: var(--brand-gold);
      font-weight: 900;
    }
    .modal-stats-cells {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
      background: #101014;
      padding: 0.85rem;
      border-radius: var(--radius-sm);
      margin-bottom: 1.5rem;
      border: 1px solid var(--border-dark);
      text-align: center;
    }
    .modal-stats-cells small {
      font-size: 0.7rem;
      color: #9CA3AF;
      text-transform: uppercase;
      font-weight: 700;
      display: block;
    }
    .modal-stats-cells strong {
      font-size: 0.95rem;
      color: var(--brand-gold);
      font-weight: 800;
    }
    .modal-chef-callout {
      background: rgba(255, 168, 0, 0.08);
      border-left: 3px solid var(--brand-gold);
      padding: 0.75rem 1rem;
      border-radius: 4px;
      font-size: 0.85rem;
      color: #E5E7EB;
      margin-bottom: 1.75rem;
      font-style: italic;
    }
    .modal-bottom-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: 1px solid var(--border-dark);
      padding-top: 1.25rem;
    }

    /* Responsive Queries */
    @media (max-width: 1024px) {
      .hero-container {
        grid-template-columns: 1fr;
        text-align: center;
      }
      .hero-script-tag {
        justify-content: center;
      }
      .hero-description {
        margin: 0 auto 2rem;
      }
      .hero-cta-group {
        justify-content: center;
      }
      .hero-reviews-row {
        justify-content: center;
      }
      .features-container {
        grid-template-columns: 1fr 1fr;
      }
      .burgers-grid {
        grid-template-columns: 1fr 1fr;
      }
      .split-promo-grid {
        grid-template-columns: 1fr;
      }
      .promo-passion-block {
        flex-direction: column;
        text-align: center;
        gap: 2rem;
      }
      .real-stamp-wrap {
        margin-left: 0;
      }
      .ecosystem-container {
        grid-template-columns: 1fr;
      }
      .testimonials-grid {
        grid-template-columns: 1fr;
      }
      .footer-container {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 768px) {
      .nav-menu {
        display: none;
      }
      .hero-title {
        font-size: 3.8rem;
      }
      .hero-burger-img {
        height: 340px;
      }
      .features-container {
        grid-template-columns: 1fr;
      }
      .burgers-grid {
        grid-template-columns: 1fr;
      }
      .modal-ingredients-grid {
        grid-template-columns: 1fr;
      }
      .footer-container {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
