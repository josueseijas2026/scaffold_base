---
// apps/ecommerce/src/pages/index.astro
import { BURGERS, HIGHLIGHT_STATS, TESTIMONIALS } from '../data/burgers.js';
const title = "Hamburger Rapid | Sabor Gourmet a Velocidad Relámpago";
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content="Hamburger Rapid: La primera versión comercial de hamburguesas gourmet artesanales preparadas a la leña con carne 100% Angus y entrega relámpago." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-canvas: #FAF8F5;
      --bg-white: #FFFFFF;
      --bg-warm: #FFFDF9;
      --surface-border: #F1E8DF;
      --surface-hover: #EAE0D5;
      --primary: #D97706;
      --primary-dark: #B45309;
      --primary-light: #FEF3C7;
      --flame: #DC2626;
      --text-main: #1E293B;
      --text-muted: #64748B;
      --text-sub: #475569;
      --shadow-sm: 0 4px 12px rgba(217, 119, 6, 0.05);
      --shadow-card: 0 10px 25px -5px rgba(217, 119, 6, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.03);
      --shadow-hover: 0 20px 35px -8px rgba(217, 119, 6, 0.18), 0 12px 18px -8px rgba(0, 0, 0, 0.05);
      --radius-sm: 10px;
      --radius-md: 16px;
      --radius-lg: 24px;
      --radius-pill: 9999px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    
    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg-canvas);
      color: var(--text-main);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    /* Top Promo Bar */
    .promo-bar {
      background: linear-gradient(90deg, #B45309 0%, #D97706 50%, #F59E0B 100%);
      color: #FFFFFF;
      text-align: center;
      padding: 0.6rem 1rem;
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.75rem;
    }
    .promo-badge {
      background: rgba(255, 255, 255, 0.25);
      padding: 0.15rem 0.5rem;
      border-radius: var(--radius-pill);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Header & Navigation */
    header.main-header {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(12px);
      position: sticky;
      top: 0;
      z-index: 50;
      border-bottom: 1px solid var(--surface-border);
      box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.03);
    }
    .header-container {
      max-width: 1240px;
      margin: 0 auto;
      padding: 1rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .brand-logo {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      color: var(--text-main);
    }
    .brand-icon {
      width: 44px;
      height: 44px;
      background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
      border: 1px solid #FCD34D;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      box-shadow: var(--shadow-sm);
    }
    .brand-text h1 {
      font-size: 1.35rem;
      font-weight: 900;
      line-height: 1.1;
      color: #92400E;
      letter-spacing: -0.02em;
    }
    .brand-text span {
      font-size: 0.72rem;
      font-weight: 700;
      color: #B45309;
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 2rem;
      list-style: none;
    }
    .nav-links a {
      text-decoration: none;
      color: var(--text-sub);
      font-size: 0.95rem;
      font-weight: 600;
      transition: color 0.2s;
    }
    .nav-links a:hover {
      color: var(--primary);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }
    .btn-pwa {
      background: #D97706;
      color: #FFFFFF;
      padding: 0.65rem 1.25rem;
      border-radius: var(--radius-pill);
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      box-shadow: 0 4px 15px rgba(217, 119, 6, 0.3);
      transition: all 0.25s ease;
    }
    .btn-pwa:hover {
      background: #B45309;
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(217, 119, 6, 0.4);
    }
    .btn-admin {
      background: #F8FAFC;
      border: 1px solid #E2E8F0;
      color: #475569;
      padding: 0.65rem 1.1rem;
      border-radius: var(--radius-pill);
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      transition: all 0.2s;
    }
    .btn-admin:hover {
      background: #EDF2F7;
      color: var(--text-main);
      border-color: #CBD5E1;
    }

    /* Hero Section */
    .hero-section {
      position: relative;
      overflow: hidden;
      padding: 4.5rem 1.5rem 3.5rem;
      background: radial-gradient(ellipse at top, #FFFBEB 0%, #FAF8F5 70%);
      border-bottom: 1px solid var(--surface-border);
    }
    .hero-container {
      max-width: 1240px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3.5rem;
      align-items: center;
    }
    .hero-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--primary-light);
      border: 1px solid #FDE68A;
      color: #92400E;
      padding: 0.4rem 1rem;
      border-radius: var(--radius-pill);
      font-size: 0.82rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 1.25rem;
    }
    .hero-title {
      font-size: 3.6rem;
      font-weight: 900;
      line-height: 1.1;
      letter-spacing: -0.03em;
      color: var(--text-main);
      margin-bottom: 1.25rem;
    }
    .hero-title span.highlight {
      background: linear-gradient(135deg, #B45309 20%, #D97706 70%, #F59E0B 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-description {
      font-size: 1.18rem;
      color: var(--text-sub);
      line-height: 1.65;
      margin-bottom: 2.25rem;
      max-width: 620px;
    }
    .hero-ctas {
      display: flex;
      gap: 1.15rem;
      align-items: center;
      flex-wrap: wrap;
      margin-bottom: 2.5rem;
    }
    .cta-primary {
      background: linear-gradient(135deg, #D97706 0%, #B45309 100%);
      color: #FFFFFF;
      padding: 0.95rem 1.85rem;
      border-radius: var(--radius-pill);
      font-size: 1.05rem;
      font-weight: 800;
      text-decoration: none;
      box-shadow: 0 10px 25px -4px rgba(217, 119, 6, 0.45);
      transition: all 0.25s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
    }
    .cta-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 30px -4px rgba(217, 119, 6, 0.55);
    }
    .cta-secondary {
      background: #FFFFFF;
      color: #92400E;
      border: 1.5px solid #FCD34D;
      padding: 0.9rem 1.65rem;
      border-radius: var(--radius-pill);
      font-size: 1.02rem;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      box-shadow: var(--shadow-sm);
    }
    .cta-secondary:hover {
      background: #FFFBEB;
      border-color: #F59E0B;
      transform: translateY(-2px);
    }

    .hero-stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      border-top: 1px solid var(--surface-border);
      padding-top: 1.75rem;
    }
    .stat-item {
      text-align: left;
    }
    .stat-number {
      font-size: 1.45rem;
      font-weight: 900;
      color: #92400E;
      line-height: 1.2;
    }
    .stat-label {
      font-size: 0.78rem;
      color: var(--text-muted);
      font-weight: 600;
    }

    .hero-media {
      position: relative;
    }
    .hero-card-featured {
      background: #FFFFFF;
      border: 1px solid var(--surface-border);
      border-radius: var(--radius-lg);
      padding: 1.5rem;
      box-shadow: var(--shadow-hover);
      position: relative;
      overflow: hidden;
    }
    .hero-card-featured img {
      width: 100%;
      height: 380px;
      object-fit: cover;
      border-radius: var(--radius-md);
      transition: transform 0.4s ease;
    }
    .hero-card-featured:hover img {
      transform: scale(1.03);
    }
    .hero-floating-badge {
      position: absolute;
      top: 2rem;
      right: 2rem;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(8px);
      padding: 0.6rem 1rem;
      border-radius: var(--radius-pill);
      font-size: 0.82rem;
      font-weight: 800;
      color: #92400E;
      border: 1px solid #FCD34D;
      box-shadow: var(--shadow-sm);
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .hero-card-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 1.25rem;
      padding-top: 0.75rem;
      border-top: 1px dashed var(--surface-border);
    }
    .hero-card-title {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--text-main);
    }
    .hero-card-price {
      font-size: 1.6rem;
      font-weight: 900;
      color: #D97706;
    }

    /* Pillars / Value proposition */
    .pillars-section {
      max-width: 1240px;
      margin: -2rem auto 4rem;
      padding: 0 1.5rem;
      position: relative;
      z-index: 20;
    }
    .pillars-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    .pillar-card {
      background: #FFFFFF;
      border: 1px solid var(--surface-border);
      border-radius: var(--radius-md);
      padding: 1.75rem;
      box-shadow: var(--shadow-card);
      transition: transform 0.25s, box-shadow 0.25s;
    }
    .pillar-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-hover);
    }
    .pillar-icon {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      background: #FEF3C7;
      color: #92400E;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.75rem;
      margin-bottom: 1.15rem;
    }
    .pillar-card h3 {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--text-main);
      margin-bottom: 0.5rem;
    }
    .pillar-card p {
      font-size: 0.92rem;
      color: var(--text-sub);
      line-height: 1.55;
    }

    /* Catalog Section */
    .catalog-section {
      max-width: 1240px;
      margin: 0 auto;
      padding: 3rem 1.5rem 5rem;
    }
    .section-header {
      text-align: center;
      max-width: 720px;
      margin: 0 auto 3rem;
    }
    .section-pill {
      display: inline-block;
      background: #FEF3C7;
      color: #92400E;
      border: 1px solid #FDE68A;
      padding: 0.35rem 0.95rem;
      border-radius: var(--radius-pill);
      font-size: 0.8rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 0.75rem;
    }
    .section-title {
      font-size: 2.6rem;
      font-weight: 900;
      letter-spacing: -0.02em;
      color: var(--text-main);
      margin-bottom: 0.85rem;
    }
    .section-subtitle {
      font-size: 1.05rem;
      color: var(--text-sub);
      line-height: 1.6;
    }

    /* Category Filter Tabs */
    .filter-tabs {
      display: flex;
      justify-content: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-bottom: 2.75rem;
    }
    .tab-btn {
      background: #FFFFFF;
      border: 1px solid var(--surface-border);
      color: var(--text-sub);
      padding: 0.65rem 1.35rem;
      border-radius: var(--radius-pill);
      font-size: 0.92rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
    }
    .tab-btn:hover {
      border-color: #F59E0B;
      color: #92400E;
    }
    .tab-btn.active {
      background: #92400E;
      color: #FFFFFF;
      border-color: #92400E;
      box-shadow: 0 4px 12px rgba(146, 64, 14, 0.25);
    }

    /* Burgers Grid */
    .burgers-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      gap: 2rem;
    }

    /* Individual Burger Card */
    .burger-card {
      background: var(--bg-white);
      border: 1px solid var(--surface-border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      box-shadow: var(--shadow-card);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
    }
    .burger-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-hover);
      border-color: #FCD34D;
    }

    .card-image-wrap {
      position: relative;
      height: 240px;
      overflow: hidden;
      background: #F8FAFC;
    }
    .card-image-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }
    .burger-card:hover .card-image-wrap img {
      transform: scale(1.06);
    }

    .badge-specialty {
      position: absolute;
      top: 1rem;
      left: 1rem;
      padding: 0.35rem 0.85rem;
      border-radius: var(--radius-pill);
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.03em;
      box-shadow: 0 4px 10px rgba(0,0,0,0.08);
      z-index: 2;
    }
    .card-prep-tag {
      position: absolute;
      bottom: 0.75rem;
      right: 0.75rem;
      background: rgba(15, 23, 42, 0.8);
      color: #FFFFFF;
      backdrop-filter: blur(6px);
      padding: 0.25rem 0.65rem;
      border-radius: var(--radius-pill);
      font-size: 0.75rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 0.3rem;
    }

    .card-body {
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .card-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.5rem;
    }
    .card-category {
      font-size: 0.76rem;
      font-weight: 800;
      color: #B45309;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .card-rating {
      font-size: 0.82rem;
      font-weight: 700;
      color: #D97706;
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }

    .card-title {
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--text-main);
      margin-bottom: 0.65rem;
      line-height: 1.3;
    }
    .card-specialty-subtitle {
      font-size: 0.82rem;
      font-weight: 700;
      color: #92400E;
      margin-bottom: 0.75rem;
      display: inline-block;
    }
    .card-desc {
      font-size: 0.92rem;
      color: var(--text-sub);
      line-height: 1.55;
      margin-bottom: 1.25rem;
      flex: 1;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .card-tags {
      display: flex;
      gap: 0.4rem;
      flex-wrap: wrap;
      margin-bottom: 1.25rem;
    }
    .card-tag-pill {
      background: #F3F4F6;
      color: #475569;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.2rem 0.55rem;
      border-radius: 6px;
    }

    .card-footer {
      border-top: 1px solid var(--surface-border);
      padding-top: 1.15rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }
    .price-box {
      display: flex;
      flex-direction: column;
    }
    .price-label {
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
    }
    .price-amount {
      font-size: 1.55rem;
      font-weight: 900;
      color: #B45309;
      line-height: 1;
    }

    .card-buttons {
      display: flex;
      gap: 0.5rem;
    }
    .btn-detail {
      background: #FFFBEB;
      border: 1px solid #FCD34D;
      color: #92400E;
      padding: 0.55rem 0.95rem;
      border-radius: var(--radius-pill);
      font-size: 0.85rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }
    .btn-detail:hover {
      background: #FDE68A;
      color: #78350F;
    }
    .btn-order-fast {
      background: #D97706;
      color: #FFFFFF;
      text-decoration: none;
      padding: 0.55rem 1rem;
      border-radius: var(--radius-pill);
      font-size: 0.85rem;
      font-weight: 700;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }
    .btn-order-fast:hover {
      background: #B45309;
    }

    /* Modal Styling */
    .modal-backdrop {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(15, 23, 42, 0.65);
      backdrop-filter: blur(8px);
      z-index: 100;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }
    .modal-backdrop.open {
      display: flex;
      animation: modalFadeIn 0.25s ease-out forwards;
    }
    @keyframes modalFadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    .modal-card {
      background: #FFFFFF;
      border-radius: var(--radius-lg);
      max-width: 680px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.3);
      border: 1px solid var(--surface-border);
      position: relative;
    }
    .modal-close-btn {
      position: absolute;
      top: 1.25rem;
      right: 1.25rem;
      width: 38px;
      height: 38px;
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid var(--surface-border);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      cursor: pointer;
      z-index: 10;
      transition: background 0.2s;
    }
    .modal-close-btn:hover {
      background: #F1F5F9;
    }
    .modal-image {
      width: 100%;
      height: 280px;
      object-fit: cover;
    }
    .modal-content {
      padding: 2rem;
    }
    .modal-header-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.75rem;
    }
    .modal-title {
      font-size: 1.85rem;
      font-weight: 900;
      color: var(--text-main);
      margin-bottom: 0.5rem;
    }
    .modal-desc {
      font-size: 1rem;
      color: var(--text-sub);
      line-height: 1.6;
      margin-bottom: 1.75rem;
    }
    .modal-section-title {
      font-size: 0.9rem;
      font-weight: 800;
      color: #92400E;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 0.75rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .ingredients-list {
      list-style: none;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem;
      margin-bottom: 1.75rem;
    }
    .ingredients-list li {
      font-size: 0.88rem;
      color: #334155;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      background: #FAF8F5;
      padding: 0.5rem 0.75rem;
      border-radius: 8px;
      border: 1px solid #F1E8DF;
    }
    .modal-details-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
      background: #FFFDF9;
      border: 1px solid #FDE68A;
      border-radius: var(--radius-md);
      padding: 1rem;
      margin-bottom: 1.75rem;
      text-align: center;
    }
    .detail-cell small {
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      display: block;
    }
    .detail-cell strong {
      font-size: 1.05rem;
      font-weight: 800;
      color: #92400E;
    }
    .modal-chef-box {
      background: #F8FAFC;
      border-left: 4px solid #D97706;
