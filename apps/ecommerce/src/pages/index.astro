  </header>

  <!-- Hero Section (Bold Fast Food Inspiration) -->
  <section class="hero-section">
    <div class="hero-container">
      
      <!-- Hero Left: Typography & CTAs -->
      <div class="hero-content-col">
        <div class="hero-script-tag">
          Made Fresh. Made to Crave. <span class="script-sparks">\ | /</span>
