  <!-- Client-side Interactive Filter & Modal Script -->
  <script is:inline>
    // Category Filtering
    const filterPills = document.querySelectorAll('.filter-pill');
    const burgerCards = document.querySelectorAll('.favorite-card');

    filterPills.forEach(pill => {
      pill.addEventListener('click', () => {
        filterPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');

        const filter = pill.getAttribute('data-filter');
        burgerCards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Modal Details Logic
    const modal = document.getElementById('burgerModal');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const modalDismissBtn = document.getElementById('modalDismissBtn');
    const openModalButtons = document.querySelectorAll('.open-modal-btn');

    function populateAndOpenModal(burger) {
      document.getElementById('modalHeroImg').src = burger.image;
      document.getElementById('modalHeroImg').alt = burger.name;
      document.getElementById('modalHeading').textContent = burger.name;
      document.getElementById('modalSpecialtyText').textContent = burger.specialtyLevel;
      document.getElementById('modalDescText').textContent = burger.description;
      document.getElementById('modalPriceTag').textContent = `$${burger.price.toFixed(2)}`;
      document.getElementById('modalRatingText').textContent = `★ ${burger.rating} (${burger.reviews} reseñas)`;
      document.getElementById('modalPrepTime').textContent = burger.prepTime;
      document.getElementById('modalKcal').textContent = burger.calories;
      document.getElementById('modalPairingText').textContent = burger.pairing || 'Papas rústicas y malteada';
      document.getElementById('modalChefNoteBox').textContent = burger.chefNotes ? `Nota del Chef: "${burger.chefNotes}"` : '';

      const badgeElem = document.getElementById('modalBadgePill');
      badgeElem.textContent = burger.badge;

      const ingrList = document.getElementById('modalIngredientsGrid');
      ingrList.innerHTML = '';
      if (burger.ingredients && burger.ingredients.length) {
        burger.ingredients.forEach(item => {
          const li = document.createElement('li');
          li.innerHTML = `<span>✓</span> ${item}`;
          ingrList.appendChild(li);
        });
      }

      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.remove('open');
      document.body.style.overflow = 'auto';
    }

    openModalButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        try {
          const data = JSON.parse(btn.getAttribute('data-burger'));
          populateAndOpenModal(data);
        } catch (err) {
          console.error('Error opening burger modal:', err);
        }
      });
    });

    closeModalBtn.addEventListener('click', closeModal);
    modalDismissBtn.addEventListener('click', closeModal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('open')) {
        closeModal();
      }
    });
  </script>

</body>
</html>
